// Skema hasil introspeksi database sekolah_dikdasmen. Jangan jalankan migrasi Prisma ke database ini.
// Tabel quran diabaikan karena tidak punya kunci unik.
generator client {
  provider = "prisma-client"
  output   = "../../src/generated/sekolah"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admin {
  id                Int    @id @default(autoincrement())
  nik               String @default("") @db.VarChar(50)
  nama              String @db.VarChar(100)
  username          String @db.VarChar(100)
  password          String @db.VarChar(100)
  level             Int    @default(0)
  kd_unit           Int    @default(0)
  login_saku        String @default("") @db.VarChar(10)
  jabatan           String @default("") @db.VarChar(100)
  tgl_akhir_jabatan String @default("0000-00-00") @db.VarChar(100)
  label             String @default("") @db.VarChar(100)
  wilayah           String @default("") @db.VarChar(100)
  asesor            String @default("BUKAN") @db.VarChar(100)
  juri_mea          String @default("") @db.VarChar(100)
  status            String @default("AKTIF") @db.VarChar(100)
  penilai           String @db.Text
  pdm               String @db.Text
  pcm               String @db.Text
  hak_akses         String @db.Text
}

model ayat {
  id         Int    @id @default(autoincrement())
  no_surah   String @db.VarChar(15)
  no_ayat    String @db.VarChar(15)
  ayat       String @db.Text
  terjemahan String @db.Text
  tafsir     String @db.Text
}

model bot_wa_config {
  id           Int       @id @default(autoincrement())
  config_key   String    @unique(map: "uk_config_key") @db.VarChar(64)
  config_value String    @db.Text
  keterangan   String?   @db.VarChar(255)
  updated_at   DateTime? @default(now()) @db.DateTime(0)
}

model bot_wa_flow {
  id        Int     @id @default(autoincrement())
  flow_code String  @unique(map: "uk_flow_code") @db.VarChar(50)
  nama_flow String  @db.VarChar(100)
  deskripsi String? @db.VarChar(255)
  aktif     Boolean @default(true)
  urutan    Int     @default(0)
}

model bot_wa_keyword {
  id         Int                       @id @default(autoincrement())
  kategori   String                    @db.VarChar(50)
  keyword    String                    @db.VarChar(100)
  match_type bot_wa_keyword_match_type @default(exact)
  aktif      Boolean                   @default(true)

  @@index([kategori, aktif], map: "idx_kategori")
}

model bot_wa_log {
  id            BigInt          @id @default(autoincrement())
  arah          bot_wa_log_arah
  wa_message_id String?         @db.VarChar(64)
  wa_phone      String?         @db.VarChar(20)
  wa_name       String?         @db.VarChar(120)
  flow_code     String?         @db.VarChar(50)
  step          String?         @db.VarChar(50)
  npsn          String?         @db.Char(8)
  pesan         String          @db.Text
  status        String          @default("success") @db.VarChar(30)
  response_api  String?         @db.Text
  created_at    DateTime        @default(now()) @db.DateTime(0)

  @@index([flow_code, created_at], map: "idx_flow")
  @@index([wa_phone, created_at], map: "idx_wa_phone_time")
}

model bot_wa_processed {
  message_id   String  @id @db.VarChar(64)
  msg_hash     String  @db.VarChar(64)
  wa_phone     String? @db.VarChar(20)
  pesan_masuk  String? @db.VarChar(500)
  processed_at Int

  @@index([msg_hash, processed_at], map: "idx_hash_time")
}

model bot_wa_session {
  id                 Int                   @id @default(autoincrement())
  session_uuid       String                @unique(map: "uk_session_uuid") @db.VarChar(36)
  wa_phone           String?               @db.VarChar(20)
  wa_lid             String?               @db.VarChar(32)
  push_name          String?               @db.VarChar(120)
  flow_code          String                @default("bantuan_reset") @db.VarChar(50)
  step               String                @db.VarChar(50)
  npsn               String?               @db.Char(8)
  nama_sekolah       String?               @db.VarChar(200)
  data_json          String?               @db.Text
  status             bot_wa_session_status @default(active)
  created_at         DateTime              @default(now()) @db.DateTime(0)
  updated_at         DateTime              @default(now()) @db.DateTime(0)
  expired_at         DateTime?             @db.DateTime(0)
  bot_wa_session_key bot_wa_session_key[]

  @@index([status, updated_at], map: "idx_status_updated")
  @@index([wa_lid], map: "idx_wa_lid")
  @@index([wa_phone], map: "idx_wa_phone")
}

model bot_wa_session_key {
  wa_key         String         @id @db.VarChar(64)
  session_id     Int
  bot_wa_session bot_wa_session @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_key_session")

  @@index([session_id], map: "idx_session_id")
}

model bot_wa_template {
  id           Int     @id @default(autoincrement())
  flow_code    String  @db.VarChar(50)
  template_key String  @db.VarChar(80)
  judul        String? @db.VarChar(120)
  keterangan   String? @db.VarChar(255)
  isi_pesan    String  @db.Text
  aktif        Boolean @default(true)

  @@unique([flow_code, template_key], map: "uk_template")
}

model gmail_inbox_messages {
  id                 Int       @id @default(autoincrement())
  admin_id           Int
