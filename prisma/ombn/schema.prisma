// Skema hasil introspeksi database ombn. Jangan jalankan migrasi Prisma ke database ini.
generator client {
  provider = "prisma-client"
  output   = "../../src/generated/ombn"
}

datasource db {
  provider = "mysql"
}

model admins {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  nama_lengkap  String          @db.VarChar(100)
  email         String          @unique(map: "email") @db.VarChar(100)
  password_hash String          @db.VarChar(255)
  role          admins_role     @default(ADMIN)
  akses_lomba   Json?
  status        admins_status?  @default(ACTIVE)
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @default(now()) @db.Timestamp(0)
  catatan       DateTime?       @db.Timestamp(0)
  lomba_tagihan lomba_tagihan[]

  @@index([email], map: "idx_admin_email")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model competitions {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  periode_id           BigInt?                @db.UnsignedBigInt
  nama_lomba           String                 @db.VarChar(150)
  kategori             String                 @db.VarChar(50)
  jenjang              Json?
  tingkat              competitions_tingkat?  @default(SEMUA)
  jenis_group          Int                    @default(1) @db.UnsignedTinyInt
  kuota                Int                    @default(200) @db.UnsignedInt
  deskripsi            String?                @db.Text
  tempat               String?                @db.Text
  biaya_pendaftaran    Decimal?               @default(0.00) @db.Decimal(10, 2)
  status               competitions_status?   @default(OPEN)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  group_wa             String?                @db.VarChar(255)
  ket                  String?                @db.Text
  jenis_persyaratan    Int                    @default(0) @db.UnsignedTinyInt
  kategori_peserta     String                 @default("SISWA") @db.VarChar(20)
  bobot_juara          Int?                   @db.UnsignedInt
  jumlah_babak         Int                    @default(1) @db.UnsignedTinyInt
  tgl_lomba            DateTime?              @db.Date
  kelas                Json?
  status_lomba         String                 @default("AKTIF") @db.VarChar(20)
  updated_at           DateTime?              @db.Timestamp(0)
  periodes             periodes?              @relation(fields: [periode_id], references: [id], onUpdate: NoAction, map: "competitions_periode_id_foreign")
  lomba_peserta        lomba_peserta[]
  student_competitions student_competitions[]

  @@index([periode_id], map: "competitions_periode_id_foreign")
  @@index([status_lomba], map: "competitions_status_lomba_index")
  @@index([tingkat], map: "idx_tingkat_lomba")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model lomba_peserta {
  id             BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  nomor_peserta  String?                      @unique(map: "lomba_peserta_nomor_peserta_unique") @db.VarChar(20)
  password       String?                      @db.Text
  competition_id BigInt                       @db.UnsignedBigInt
  school_id      BigInt                       @db.UnsignedBigInt
  tagihan_id     BigInt?                      @db.UnsignedBigInt
  nama           String                       @db.VarChar(150)
  nama_kelompok  String?                      @db.VarChar(150)
  nisn           String?                      @db.VarChar(30)
  nik            String?                      @db.VarChar(16)
  tempat_lahir   String?                      @db.VarChar(100)
  tanggal_lahir  DateTime?                    @db.Date
  jenis_kelamin  lomba_peserta_jenis_kelamin?
  anggota        Json?
  berkas         String?                      @db.VarChar(255)
  foto           String?                      @db.VarChar(255)
  nominal        Decimal                      @default(0.00) @db.Decimal(12, 2)
  presensi       DateTime?                    @db.Timestamp(0)
  peringkat      Int?                         @db.UnsignedSmallInt
  babak          Json?
  perlengkapan   Json?
  pre_group_npsn String?                      @db.VarChar(150)
  created_at     DateTime?                    @db.Timestamp(0)
  updated_at     DateTime?                    @db.Timestamp(0)
  competitions   competitions                 @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lomba_peserta_competition_id_foreign")
  schools        schools                      @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lomba_peserta_school_id_foreign")
  lomba_tagihan  lomba_tagihan?               @relation(fields: [tagihan_id], references: [id], onUpdate: NoAction, map: "lomba_peserta_tagihan_id_foreign")

  @@index([competition_id, school_id], map: "lomba_peserta_competition_id_school_id_index")
  @@index([peringkat], map: "lomba_peserta_peringkat_index")
  @@index([presensi], map: "lomba_peserta_presensi_index")
  @@index([school_id], map: "lomba_peserta_school_id_foreign")
  @@index([tagihan_id], map: "lomba_peserta_tagihan_id_foreign")
}

model lomba_tagihan {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  school_id       BigInt               @db.UnsignedBigInt
  nomor_tagihan   String               @unique(map: "lomba_tagihan_nomor_tagihan_unique") @db.VarChar(40)
  jumlah_peserta  Int                  @default(0) @db.UnsignedInt
  nominal_dasar   Decimal              @default(0.00) @db.Decimal(12, 2)
  kode_unik       Int                  @db.UnsignedSmallInt
  total_bayar     Decimal              @db.Decimal(12, 2)
  status          lomba_tagihan_status @default(TAGIHAN)
  bukti_bayar     String?              @db.VarChar(255)
  nama_pengirim   String?              @db.VarChar(150)
  tgl_upload      DateTime?            @db.Timestamp(0)
  tgl_validasi    DateTime?            @db.Timestamp(0)
  divalidasi_oleh BigInt?              @db.UnsignedBigInt
  keterangan      String?              @db.Text
  created_at      DateTime?            @db.Timestamp(0)
  updated_at      DateTime?            @db.Timestamp(0)
  lomba_peserta   lomba_peserta[]
  admins          admins?              @relation(fields: [divalidasi_oleh], references: [id], onUpdate: NoAction, map: "lomba_tagihan_divalidasi_oleh_foreign")
  schools         schools              @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lomba_tagihan_school_id_foreign")

  @@index([divalidasi_oleh], map: "lomba_tagihan_divalidasi_oleh_foreign")
  @@index([school_id, status], map: "lomba_tagihan_school_id_status_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model periodes {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  periode      String         @db.VarChar(20)
  semester     String         @db.VarChar(30)
  created_at   DateTime?      @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  competitions competitions[]

  @@unique([periode, semester], map: "periodes_periode_semester_unique")
}

model school_accounts {
  id                        BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  school_id                 BigInt                       @db.UnsignedBigInt
  nama_operator             String                       @db.VarChar(100)
  email                     String                       @unique(map: "email") @db.VarChar(100)
  nomor_wa                  String                       @db.VarChar(25)
  password                  String                       @db.VarChar(255)
  password_hash             String                       @db.VarChar(255)
  status_akun               school_accounts_status_akun? @default(PENDING_VERIFICATION)
  email_verification_token  String?                      @db.VarChar(100)
  email_verified_at         DateTime?                    @db.Timestamp(0)
  reset_password_token      String?                      @db.VarChar(100)
  reset_password_expires_at DateTime?                    @db.Timestamp(0)
  created_at                DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                DateTime?                    @default(now()) @db.Timestamp(0)
  remember_token            String?                      @db.VarChar(100)
  schools                   schools                      @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_school_account_school")

  @@index([email], map: "idx_email")
  @@index([reset_password_token], map: "idx_reset_token")
  @@index([school_id], map: "idx_school_id")
  @@index([email_verification_token], map: "idx_verification_token")
}

model schools {
  id                  BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  npsn                String                     @unique(map: "npsn") @db.VarChar(20)
  nama_sekolah        String                     @db.VarChar(150)
  tingkat             schools_tingkat
  provinsi            String                     @default("Jawa Timur") @db.VarChar(100)
  kode_provinsi       String?                    @db.VarChar(10)
  kabupaten_kota      String                     @db.VarChar(100)
  kecamatan           String?                    @db.VarChar(100)
  kode_kecamatan      String?                    @db.VarChar(10)
  kode_kabupaten      String?                    @db.VarChar(10)
  alamat_lengkap      String                     @db.Text
  nama_kepala_sekolah String                     @db.VarChar(100)
  status_verifikasi   schools_status_verifikasi? @default(VERIFIED)
  created_at          DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at          DateTime?                  @default(now()) @db.Timestamp(0)
  lomba_peserta       lomba_peserta[]
  lomba_tagihan       lomba_tagihan[]
  school_accounts     school_accounts[]

  @@index([kabupaten_kota], map: "idx_kabupaten")
  @@index([npsn], map: "idx_npsn")
  @@index([tingkat], map: "idx_tingkat")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "last_activity")
  @@index([user_id], map: "user_id")
}

model setting_ombn {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tahun        String    @unique(map: "setting_ombn_tahun_unique") @db.VarChar(4)
  panduan      String?   @db.VarChar(255)
  sertifikat   String?   @db.VarChar(255)
  juara        String?   @db.VarChar(255)
  kop          String?   @db.VarChar(255)
  id_card      String?   @db.VarChar(255)
  flayer       String?   @db.VarChar(255)
  card_panitia String?   @db.VarChar(255)
  ser_panitia  String?   @db.VarChar(255)
  logo         String?   @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model student_competitions {
  id                BigInt                                  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt                                  @db.UnsignedBigInt
  competition_id    BigInt                                  @db.UnsignedBigInt
  status_pembayaran student_competitions_status_pembayaran? @default(PENDING)
  created_at        DateTime?                               @default(now()) @db.Timestamp(0)
  competitions      competitions                            @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sc_competition")
  users             users                                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sc_user")

  @@unique([user_id, competition_id], map: "uk_user_competition")
  @@index([competition_id], map: "fk_sc_competition")
}

model user_sessions {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt    @db.UnsignedBigInt
  session_token String    @unique(map: "session_token") @db.VarChar(64)
  ip_address    String    @db.VarChar(45)
  user_agent    String?   @db.Text
  expires_at    DateTime  @db.Timestamp(0)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_sessions")

  @@index([user_id], map: "idx_user_id")
}

model users {
  id                   BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  nomor_peserta        String                   @unique(map: "nomor_peserta") @db.VarChar(30)
  nama_lengkap         String                   @db.VarChar(100)
  nik                  String?                  @db.VarChar(20)
  nisn                 String?                  @unique(map: "idx_nisn_unique") @db.VarChar(20)
  jenis_kelamin        users_jenis_kelamin?
  tanggal_lahir        DateTime?                @db.Date
  alamat               String?                  @db.Text
  email                String                   @unique(map: "email") @db.VarChar(100)
  nomor_hp             String                   @db.VarChar(20)
  school_id            BigInt?                  @db.UnsignedBigInt
  password_hash        String                   @db.VarChar(255)
  status_pembayaran    users_status_pembayaran? @default(PENDING)
  status_akun          users_status_akun?       @default(ACTIVE)
  created_at           DateTime?                @default(now()) @db.Timestamp(0)
  updated_at           DateTime?                @default(now()) @db.Timestamp(0)
  student_competitions student_competitions[]
  user_sessions        user_sessions[]

  @@index([email], map: "idx_email")
  @@index([nomor_peserta], map: "idx_nomor_peserta")
  @@index([status_pembayaran], map: "idx_status_pembayaran")
  @@index([school_id], map: "idx_user_school_id")
}

enum schools_tingkat {
  SD
  MI
  SMP
  MTs
  SMA
  MA
  SMK
}

enum student_competitions_status_pembayaran {
  PENDING
  PAID
}

enum admins_role {
  ADMIN
  SUPERADMIN
  JURI
}

enum competitions_tingkat {
  SEMUA
  SD_MI      @map("SD/MI")
  SMP_MTs    @map("SMP/MTs")
  SMA_MA_SMK @map("SMA/MA/SMK")
}

enum users_jenis_kelamin {
  L
  P
}

enum admins_status {
  ACTIVE
  SUSPENDED
}

enum lomba_tagihan_status {
  TAGIHAN
  PROSES
  LUNAS
}

enum school_accounts_status_akun {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum competitions_status {
  OPEN
  CLOSED
}

enum lomba_peserta_jenis_kelamin {
  L
  P
}

enum schools_status_verifikasi {
  VERIFIED
  PENDING
}

enum users_status_pembayaran {
  PENDING
  PAID
  EXPIRED
}

enum users_status_akun {
  ACTIVE
  SUSPENDED
}


