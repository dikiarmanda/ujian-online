// =============================================================================
// Skema database: Web Ujian Online (MySQL 8, Prisma)
// Acuan: PRD v2.0 bagian 4 (fitur), 5 (arsitektur), 6 (model data)
//
// Konvensi
// - Nama model dan kolom berbahasa Inggris (camelCase); nama tabel snake_case
//   lewat @@map. Kolom TIDAK di-@map, jadi pada raw SQL pakai nama kolom
//   persis seperti di bawah, dengan backtick (contoh: `attemptId`).
// - Semua waktu disimpan dalam UTC. Tampilkan ke pengguna dalam zona Asia/Jakarta.
// - Koneksi database TIDAK diatur di sini. Pada Prisma 7, URL koneksi dan
//   pengaturan pool diatur di berkas konfigurasi Prisma dan driver adapter
//   MySQL (@prisma/adapter-mariadb). Sesuaikan blok generator dengan versi
//   Prisma yang dipakai.
// - Gunakan charset utf8mb4 pada database.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// Enum
// -----------------------------------------------------------------------------

enum Role {
  PARTICIPANT // peserta
  ADMIN
  GRADER // petugas penilai uraian
}

enum QuestionType {
  MULTIPLE_CHOICE // pilihan ganda
  ESSAY // uraian
  SHORT_ANSWER // jawaban singkat
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamPhase {
  NOT_STARTED
  RUNNING
  ENDED
}

enum AttemptStatus {
  IN_PROGRESS // sedang mengerjakan
  SUBMITTED // dikirim peserta
  TIME_EXPIRED // dikirim otomatis karena waktu habis
}

// Status penilaian tingkat peserta (khusus soal uraian)
enum GradingStatus {
  NOT_GRADED
  PARTIAL
  COMPLETED
}

// Status penilaian tingkat jawaban
enum AnswerGradingState {
  NOT_REQUIRED // pilihan ganda: dinilai otomatis
  PENDING // uraian: menunggu petugas
  LOCKED // uraian: sedang dibuka satu petugas
  GRADED // uraian: sudah dinilai
}

enum ViolationType {
  FULLSCREEN_EXIT
  TAB_SWITCH
  WINDOW_BLUR
  COPY_PASTE
  RIGHT_CLICK
}

// -----------------------------------------------------------------------------
// Pengguna. Password tidak disimpan di sini; login peserta dan admin dicek ke OMBN.
// -----------------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  externalId   String?   @unique @db.VarChar(100) // ombn-peserta:{id} atau ombn-admin:{id}
  identity     String    @db.VarChar(100) // nomor peserta atau email admin
  nisn         String?   @unique @db.VarChar(30) // kunci rekap untuk sistem lain
  name         String    @db.VarChar(200)
  role         Role      @default(PARTICIPANT)
  groupName    String?   @db.VarChar(150) // kelompok/kelas (opsional)
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdQuestions    Question[]
  createdPackages     QuestionPackage[]
  createdExams        Exam[]              @relation("ExamCreatedBy")
  startedExams        Exam[]              @relation("ExamStartedBy")
  endedExams          Exam[]              @relation("ExamEndedBy")
  attempts            ExamAttempt[]
  lockedAnswers       AttemptAnswer[]     @relation("AnswerLockedBy")
  gradedAnswers       AttemptAnswer[]     @relation("AnswerGradedBy")
  syncLogs            SyncLog[]
  auditLogs           AuditLog[]
  apiClients          ApiClient[]

  @@index([identity])
  @@index([role, isActive])
  @@map("users")
}

model SyncLog {
  id            Int       @id @default(autoincrement())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  successCount  Int       @default(0)
  failedCount   Int       @default(0)
  message       String?   @db.Text
  triggeredById Int? // null bila dijalankan terjadwal

  triggeredBy User?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  failures    SyncFailure[]

  @@index([startedAt])
  @@map("sync_logs")
}

// Alasan gagal per baris, sesuai PRD 4.1.1 (bukan hanya agregat di SyncLog).
model SyncFailure {
  id         Int      @id @default(autoincrement())
  syncLogId  Int
  externalId String?  @db.VarChar(100)
  identity   String?  @db.VarChar(100)
  reason     String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  syncLog SyncLog @relation(fields: [syncLogId], references: [id], onDelete: Cascade)

  @@index([syncLogId])
  @@map("sync_failures")
}

// -----------------------------------------------------------------------------
// Bank soal dan bank jawaban
// -----------------------------------------------------------------------------

model QuestionCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(500)

  questions Question[]

  @@map("question_categories")
}

model Question {
  id            Int          @id @default(autoincrement())
  code          String       @unique @db.VarChar(50)
  categoryId    Int
  type          QuestionType
  body          String       @db.Text
  imagePath     String?      @db.VarChar(255)
  defaultWeight      Decimal @default(1) @db.Decimal(6, 2)
  defaultWrongWeight Decimal @default(1) @db.Decimal(6, 2)
  isActive           Boolean @default(true)
  createdById   Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  category      QuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  options       AnswerOption[]
  essayKey      EssayKey?
  shortAnswerKey ShortAnswerKey?
  packageItems         QuestionPackageItem[]
  examPackageQuestions ExamPackageQuestion[]
  answers              AttemptAnswer[]

  @@index([categoryId, type])
  @@index([isActive])
  @@index([deletedAt])
  @@map("questions")
}

// Bank jawaban pilihan ganda: opsi dan kunci
model AnswerOption {
  id         Int     @id @default(autoincrement())
  questionId Int
  label      String  @db.VarChar(5) // A, B, C, D, ...
  body       String  @db.Text
  imagePath  String? @db.VarChar(255)
  isCorrect  Boolean @default(false) // tepat satu per soal (validasi di aplikasi)
  sortOrder  Int     @default(0)

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@unique([questionId, label])
  @@index([questionId])
  @@map("answer_options")
}

// Bank jawaban uraian: kunci/pedoman dan rubrik skor
model EssayKey {
  id         Int     @id @default(autoincrement())
  questionId Int     @unique
  answerKey  String  @db.Text
  rubric     String? @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("essay_keys")
}

// Bank jawaban singkat: kunci jawaban tunggal (case-insensitive)
model ShortAnswerKey {
  id         Int     @id @default(autoincrement())
  questionId Int     @unique
  answerKey  String  @db.VarChar(500) // jawaban singkat, dicek case-insensitive

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("short_answer_keys")
}

// -----------------------------------------------------------------------------
// Template paket soal (bank). Dipilih saat membuat ujian; isi disalin ke ExamQuestion.
// -----------------------------------------------------------------------------

model QuestionPackage {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(200)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        QuestionPackageItem[]
  examPackages ExamPackage[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("question_packages")
}

model QuestionPackageItem {
  id          Int     @id @default(autoincrement())
  packageId   Int
  questionId  Int
  sortOrder   Int
  weight      Decimal @db.Decimal(6, 2)
  wrongWeight Decimal @default(0) @db.Decimal(6, 2)

  package  QuestionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([packageId, questionId])
  @@unique([packageId, sortOrder])
  @@index([questionId])
  @@map("question_package_items")
}

// -----------------------------------------------------------------------------
// Jadwal ujian, paket per jenjang, dan pengerjaan peserta
// -----------------------------------------------------------------------------

model Exam {
  id                Int        @id @default(autoincrement())
  name              String     @db.VarChar(200) // snapshot dari competitions.nama_lomba
  competitionId     Int // referensi ke ombn.competitions.id (tanpa FK); satu lomba boleh beberapa ujian
  attendanceOpensAt DateTime
  startsAt          DateTime // jadwal rencana (informasi)
  durationMinutes   Int
  shuffleQuestions  Boolean    @default(true)
  shuffleOptions    Boolean    @default(true)
  status            ExamStatus @default(DRAFT)
  phase             ExamPhase  @default(NOT_STARTED)
  startedAt         DateTime?
  startedById       Int?
  endedAt           DateTime?
  endedById         Int?
  createdById       Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  createdBy  User          @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  startedBy  User?         @relation("ExamStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy    User?         @relation("ExamEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  packages   ExamPackage[]
  attempts   ExamAttempt[]
  apiClients ApiClientExam[]

  @@index([competitionId])
  @@index([status])
  @@index([phase])
  @@index([startsAt])
  @@index([deletedAt])
  @@map("exams")
}

// Plotting paket soal per kelompok jenjang (SD / SMP / SMA).
model ExamPackage {
  id        Int    @id @default(autoincrement())
  examId    Int
  jenjang   String @db.VarChar(10) // "SD" | "SMP" | "SMA"
  packageId Int

  exam            Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionPackage QuestionPackage       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  questions       ExamPackageQuestion[]

  @@unique([examId, jenjang])
  @@index([packageId])
  @@map("exam_packages")
}

// Salinan soal per ExamPackage. Bobot disalin agar nilai lama tidak berubah
// bila paket/bank soal diedit kemudian.
model ExamPackageQuestion {
  id            Int     @id @default(autoincrement())
  examPackageId Int
  questionId    Int
  sortOrder     Int
  weight        Decimal @db.Decimal(6, 2)
  wrongWeight   Decimal @default(0) @db.Decimal(6, 2)

  examPackage ExamPackage @relation(fields: [examPackageId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examPackageId, questionId])
  @@unique([examPackageId, sortOrder])
  @@index([questionId])
  @@map("exam_package_questions")
}

// -----------------------------------------------------------------------------
// Pengerjaan, jawaban, dan penilaian
// -----------------------------------------------------------------------------

model ExamAttempt {
  id                Int            @id @default(autoincrement())
  examId            Int
  userId            Int
  jenjang           String         @db.VarChar(10) // kelompok hasil pemetaan
  packageId         Int // QuestionPackage yang didapat dari ExamPackage
  attendedAt        DateTime?
  // Null sampai peserta pertama kali membuka soal.
  startedAt         DateTime?
  // Batas akhir: startedAt + durasi + extraSeconds
  expiresAt         DateTime?
  extraSeconds      Int            @default(0)
  submittedAt       DateTime?
  status            AttemptStatus  @default(IN_PROGRESS)
  // Urutan soal dan opsi untuk peserta ini (hasil pengacakan).
  questionOrder     Json?
  optionOrder       Json?
  lastQuestionIndex Int            @default(0)
  mcScore           Decimal?       @db.Decimal(8, 2)
  essayScore        Decimal?       @db.Decimal(8, 2)
  totalScore        Decimal?       @db.Decimal(8, 2)
  gradingStatus     GradingStatus  @default(NOT_GRADED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  exam       Exam             @relation(fields: [examId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers    AttemptAnswer[]
  violations ViolationLog[]

  @@unique([examId, userId])
  @@index([examId, status])
  @@index([examId, gradingStatus])
  @@index([updatedAt, id])
  @@map("exam_attempts")
}

// Satu baris per (pengerjaan, soal). Kunci unik (attemptId, questionId) adalah
// target INSERT ... ON DUPLICATE KEY UPDATE dari worker. Contoh:
//
//   INSERT INTO attempt_answers
//     (attemptId, questionId, selectedOptionId, essayText, isDoubtful, answeredAt, updatedAt)
//   VALUES (?, ?, ?, ?, ?, ?, NOW(3)), ...
//   AS new
//   ON DUPLICATE KEY UPDATE
//     selectedOptionId = new.selectedOptionId,
//     essayText        = new.essayText,
//     isDoubtful       = new.isDoubtful,
//     answeredAt       = new.answeredAt,
//     updatedAt        = NOW(3);
//
// `@updatedAt` Prisma tidak berlaku pada raw SQL, jadi isi updatedAt manual.
// Worker tidak boleh menimpa baris setelah pengerjaan berstatus bukan
// IN_PROGRESS (cek di aplikasi).
//
// Klaim penilaian satu petugas per jawaban (atomik, satu query):
//
//   UPDATE attempt_answers
//      SET gradingState = 'LOCKED', lockedById = ?, lockedAt = NOW(3)
//    WHERE id = ?
//      AND (gradingState = 'PENDING'
//           OR (gradingState = 'LOCKED' AND lockedAt < NOW(3) - INTERVAL ? SECOND));
//
// Bila jumlah baris terubah = 0, jawaban sudah diambil petugas lain.
model AttemptAnswer {
  id               Int                @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int? // pilihan ganda
  essayText        String?            @db.MediumText // uraian
  shortAnswerText  String?            @db.VarChar(500) // jawaban singkat
  isDoubtful       Boolean            @default(false) // ragu-ragu
  answeredAt       DateTime?
  isCorrect        Boolean? // pilihan ganda & jawaban singkat, diisi saat pengiriman
  score            Decimal?           @db.Decimal(6, 2)
  gradingState     AnswerGradingState @default(NOT_REQUIRED)
  lockedById       Int?
  lockedAt         DateTime?
  gradedById       Int?
  gradedAt         DateTime?
  gradingNote      String?            @db.Text
  updatedAt        DateTime           @default(now())

  attempt        ExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption AnswerOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)
  lockedBy       User?         @relation("AnswerLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  gradedBy       User?         @relation("AnswerGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([gradingState, lockedAt])
  @@index([questionId])
  @@index([gradedById])
  @@map("attempt_answers")
}

model ViolationLog {
  id             Int           @id @default(autoincrement())
  attemptId      Int
  type           ViolationType
  occurredAt     DateTime      @default(now())
  questionNumber Int?
  detail         String?       @db.VarChar(255)

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@map("violation_logs")
}

// -----------------------------------------------------------------------------
// Log audit: login, absensi, pengiriman ujian, penilaian, perubahan admin
// -----------------------------------------------------------------------------

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(60)
  meta       Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Klien API rekap nilai
// -----------------------------------------------------------------------------

enum ApiClientStatus {
  ACTIVE
  REVOKED
}

model ApiClient {
  id                 Int             @id @default(autoincrement())
  name               String          @db.VarChar(150)
  description        String?         @db.VarChar(500)
  status             ApiClientStatus @default(ACTIVE)
  allExams           Boolean         @default(false)
  allowedIps         Json?
  rateLimitPerMinute Int             @default(60)
  createdById        Int
  createdAt          DateTime        @default(now())
  revokedAt          DateTime?

  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  exams      ApiClientExam[]
  keys       ApiKey[]
  accessLogs ApiAccessLog[]

  @@index([status])
  @@map("api_clients")
}

model ApiClientExam {
  id       Int @id @default(autoincrement())
  clientId Int
  examId   Int

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exam   Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([clientId, examId])
  @@index([examId])
  @@map("api_client_exams")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  clientId   Int
  prefix     String    @unique @db.VarChar(32)
  keyHash    String    @db.VarChar(64)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  client     ApiClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accessLogs ApiAccessLog[]

  @@index([clientId])
  @@map("api_keys")
}

model ApiAccessLog {
  id         Int      @id @default(autoincrement())
  clientId   Int
  keyId      Int?
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(255)
  query      String?  @db.VarChar(500)
  statusCode Int
  durationMs Int
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key    ApiKey?   @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("api_access_logs")
}
